    <string name="disclosure_plugin_description">Bazı eklentiler düzgün çalışmak için ek izinler gerektirebilir. Dynamic Island yalnızca kesinlikle gerekli izinleri isteyecektir.</string>
    <string name="disclosure_privacy_title">Gizlilik</string>
